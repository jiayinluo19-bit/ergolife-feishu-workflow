APP_ENV=development
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_TEST_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=open_id
DATABASE_URL=
WORKFLOW_REPOSITORY=auto
# 商品主数据数据库（Railway 建议引用 ecommerce-postgres.DATABASE_URL）
PRODUCT_DATABASE_URL=
# Web 工作台使用的飞书 OAuth 回调；必须在飞书安全设置中登记
PUBLIC_BASE_URL=http://127.0.0.1:8000
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/auth/feishu/callback
SESSION_SECRET=
# 真实用户与流程角色的映射（JSON，使用飞书 open_id）
FEISHU_ROLE_USER_MAP_JSON={}
# MVP 演示时允许切换全部部门角色；正式环境建议关闭
DEMO_MODE=true
